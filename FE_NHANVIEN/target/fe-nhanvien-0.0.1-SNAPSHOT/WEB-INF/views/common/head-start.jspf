<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${empty pageTitle ? 'WEBPC Nhan Vien' : pageTitle}" /></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="${ctx}/assets/css/admin-theme.css">
    <style>
        body.auth-page {
            background: linear-gradient(140deg, #0f172a 0%, #1d4ed8 50%, #e2e8f0 100%);
            min-height: 100vh;
        }
        .content-body .table td, .content-body .table th {
            vertical-align: middle;
        }
        .status-pill {
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            font-size: .8rem;
            font-weight: 700;
            gap: .35rem;
            padding: .35rem .7rem;
        }
        .status-pill.ok {
            background: #dcfce7;
            color: #166534;
        }
        .status-pill.off {
            background: #fee2e2;
            color: #991b1b;
        }
        .feature-box {
            border: 1px dashed #cbd5e1;
            border-radius: 1rem;
            padding: 1rem 1.2rem;
        }
        .section-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 12px 30px rgba(15, 23, 42, .07);
            padding: 1.2rem;
        }
    </style>
