# Copy file nay thanh ".env" cung thu muc voi docker-compose.yml (deploy/.env)
#
# Luu y:
# - Port hop le: 1..65535
# - Ban dang yeu cau DB public (55432). Khuyen nghi chan firewall theo IP tin cay.

DB_NAME=webpc
DB_USERNAME=sylein
DB_PASSWORD=123456
DB_PUBLIC_PORT=55432

BE_PUBLIC_PORT=8081
BE_PUBLIC_BASE_URL=http://34.126.165.66:8081
BE_JWT_ISSUER=http://34.126.165.66:8081
BE_JWT_AUDIENCE=http://34.126.165.66:8081
SPRING_PROFILES_ACTIVE=prod

# FE/FE_NHANVIEN khong the cung bind 1 port tren cung 1 VM neu chay 2 service rieng.
# Hien tai da "gọp chung": 1 Jetty phuc vu ca 2 WAR.
# - FE: /
# - FE_NHANVIEN: /nhanvien
FE_PUBLIC_PORT=22222
