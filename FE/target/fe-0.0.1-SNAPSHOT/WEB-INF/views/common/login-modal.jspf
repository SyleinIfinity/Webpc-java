<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<c:set var="resolvedReturnUrl" value="${empty returnUrl ? rawRequestPath : returnUrl}" />
<div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header border-0 p-4 pb-0">
                <h3 class="fw-bold mb-0">Đăng Nhập</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" action="${ctx}/Login">
                    <input type="hidden" name="returnUrl" value="${fn:escapeXml(resolvedReturnUrl)}">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên đăng nhập</label>
                        <input name="TenDangNhap" type="text" class="form-control form-control-lg"
                               placeholder="Nhập tên đăng nhập"
                               value="${fn:escapeXml(param.TenDangNhap)}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật Khẩu</label>
                        <input name="MatKhau" type="password" class="form-control form-control-lg" placeholder="Nhập mật khẩu">
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">Đăng Nhập</button>
                    <c:if test="${not empty loginError}">
                        <div class="alert alert-danger mb-0">
                            <c:out value="${loginError}" />
                        </div>
                    </c:if>
                </form>
                <div class="text-center mt-4">
                    <p class="mb-0 text-secondary">
                        Chưa có tài khoản?
                        <a href="${ctx}/Register" class="text-primary fw-bold text-decoration-none">Đăng ký ngay</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
